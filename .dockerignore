!web/
!web/**
!dist/
!dist/**
!scripts/
!scripts/**
!docs/
!docs/*evaluation*.json
**/__pycache__/**
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.db
**/*.sqlite*
**/.DS_Store
