# Allowlist: customer uploads, report/proposal files, credentials and tests never
# enter the build context. Runtime requirements and source are copied explicitly.
**
!Dockerfile
!package.json
!backend/
!backend/requirements.txt
!backend/constraints.txt
!backend/strata/
!backend/strata/**
!web/
!web/**
!dist/
!dist/**
!scripts/
!scripts/*.py
!scripts/*.mjs
!examples/
!examples/adapter-transfer.json
!examples/adapter-mass.json
!examples/case-suite.synthetic.json
!examples/rule-package.synthetic.json
!examples/mass-pass.csv
!examples/mass-error.csv
!examples/mass-missing.csv
!examples/transfer-error.json
!examples/transfer-source.csv
!examples/transfer-target.json
!docs/
!docs/*evaluation*.json
**/__pycache__/**
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.db
**/*.sqlite*
**/.DS_Store
