# Optional server-side model task routing. No real secrets belong in this file or dist/.
# Empty key or model keeps model routing disabled. There is no default model.
STRATA_LLM_API_KEY=
STRATA_LLM_MODEL=
# Optional: defaults to this official base URL when omitted.
STRATA_LLM_BASE_URL=https://api.openai.com/v1
# This file is an example only. The app does not automatically load .env files.
