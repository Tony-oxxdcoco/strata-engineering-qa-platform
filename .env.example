# Copy to .env locally. Actual .env files and credentials are never packaged.
STRATA_PORT=4180
STRATA_IMAGE_TAG=local
STRATA_CONTAINER_DATA_DIR=/app/.runtime
# Generate a fresh random token for first account creation; remove after setup.
# The Docker bridge is not loopback; enter this token in the first-account form.
STRATA_SETUP_TOKEN=
# Optional local model profile; leave blank for a model-free base application.
STRATA_OLLAMA_MODEL=
STRATA_OLLAMA_IMAGE=ollama/ollama:0.40.0
# Optional client-owned read-only connector. No URL means disabled.
STRATA_ETABS_URL=
STRATA_ETABS_TOKEN=
STRATA_ETABS_TIMEOUT_SECONDS=15
# Do not configure external hosts/origins for the current local-only delivery.
STRATA_ALLOWED_HOSTS=
STRATA_PUBLIC_ORIGIN=
